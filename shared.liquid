<!--
  Octopus Agile — next 24 hours (TRMNL recipe). Shared tab: styles + the renderer every layout calls.
  Prices come from Octopus Energy's public API; no account needed.
  Polling URL:
    https://api.octopus.energy/v1/products/{{ product }}/electricity-tariffs/E-1R-{{ product }}-{{ region }}/standard-unit-rates/?page_size=100&period_from={{ "now" | date: "%Y-%m-%dT%H:%M:00%z" | url_encode }}
  period_from=now makes the data change at :00/:30, so TRMNL redraws when the current half-hour changes.
  Form fields: region (A–P), product (Agile product code), flexible_price (optional comparison line, p/kWh inc VAT).
  1-bit friendly: black, white and hatching only.
-->
<style>
  .agile, .agile svg text { font-family: "Inter Variable", Inter, sans-serif; }
  .agile svg text { fill: #000; }
  /* --s scales everything from the 800×480 design to the device (set by agileRender) */
  .agile { --s: 1; }
  .agile .stats { display: flex; flex-wrap: wrap; gap: calc(10px * var(--s)); margin-bottom: calc(4px * var(--s)); }
  .agile .stat { flex: 1; min-width: 0; border: 2px solid #000; border-radius: calc(8px * var(--s)); padding: calc(5px * var(--s)) calc(10px * var(--s)); }
  .agile .stat.now { background: #000; color: #fff; }
  .agile .k { font-size: calc(16px * var(--s)); line-height: 1.15; white-space: nowrap; }
  .agile .v { font-size: calc(30px * var(--s)); font-weight: 700; line-height: 1.15; white-space: nowrap; }
  .agile .s { font-size: calc(16px * var(--s)); line-height: 1.15; white-space: nowrap; }
  .agile.compact .stats { gap: calc(6px * var(--s)); margin-bottom: calc(2px * var(--s)); }
  .agile.compact .stat { padding: calc(3px * var(--s)) calc(7px * var(--s)); border-radius: calc(6px * var(--s)); }
  .agile.compact .k, .agile.compact .s { font-size: calc(13px * var(--s)); }
  .agile.compact .v { font-size: calc(21px * var(--s)); }
  .agile .legend { display: flex; gap: calc(18px * var(--s)); font-size: calc(16px * var(--s)); align-items: center; }
  .agile .legend svg { vertical-align: -2px; margin-right: calc(5px * var(--s)); }
</style>
<script>
/* agileRender(rootId, untilId, opts)
   opts: W, H (chart size on an 800×480 TRMNL OG; the chart measures its container and scales
   to larger screens such as TRMNL X, landscape or portrait), stats (subset of "now","best","avoid"),
   compact, legend, tick (hours between axis labels) */
function agileRender(rootId, untilId, opts) {
  var RATES = {{ results | json }};
  var FLEX = parseFloat("{{ flexible_price }}");   // blank = no Flexible comparison
  var HAS_FLEX = !isNaN(FLEX);
  var WINDOW = 48;   // always the next 24 hours, so bars keep the same width
  var TZ = "Europe/London", HH = 1800000;
  var root = document.getElementById(rootId), untilEl = document.getElementById(untilId);

  var fmt = function (d, o) { return new Intl.DateTimeFormat("en-GB", Object.assign({ timeZone: TZ }, o)).format(d); };
  var hm = function (d) { return fmt(d, { hour: "2-digit", minute: "2-digit", hourCycle: "h23" }); };
  var dayKey = function (d) { return fmt(d, { year: "numeric", month: "2-digit", day: "2-digit" }); };

  var now = new Date();
  var start = new Date(Math.floor(now.getTime() / HH) * HH);
  var byTime = {};
  (RATES || []).forEach(function (r) { byTime[new Date(r.valid_from).getTime()] = r.value_inc_vat; });
  var slots = [];
  for (var k = 0; k < WINDOW; k++) {
    var t = new Date(start.getTime() + k * HH), p = byTime[t.getTime()];
    slots.push({ from: t, to: new Date(t.getTime() + HH), p: p === undefined ? null : p });
  }
  var priced = slots.filter(function (s) { return s.p !== null; });
  var nPriced = 0; while (nPriced < WINDOW && slots[nPriced].p !== null) nPriced++;
  var drawn = "drawn " + hm(now);
  if (nPriced < 4) {
    root.innerHTML = '<div class="v">Waiting for Agile prices</div><div class="s">Octopus publishes the next day around 4pm.</div>';
    if (untilEl) untilEl.textContent = drawn;
    return;
  }

  var sorted = priced.map(function (s) { return s.p; }).sort(function (a, b) { return a - b; });
  var cheapCut = sorted[Math.max(0, Math.ceil(sorted.length / 3) - 1)];
  var best = null, worst = null;
  for (var i = 0; i + 3 < nPriced; i++) {
    var avg = (slots[i].p + slots[i + 1].p + slots[i + 2].p + slots[i + 3].p) / 4;
    if (!best || avg < best.avg) best = { i: i, avg: avg };
    if (!worst || avg > worst.avg) worst = { i: i, avg: avg };
  }
  var span = function (w) { return hm(slots[w.i].from) + "–" + hm(slots[w.i + 3].to); };
  var when = function (d) { return dayKey(d) === dayKey(now) ? "today" : "tomorrow"; };
  var last = new Date(Math.max.apply(null, (RATES || []).map(function (r) { return new Date(r.valid_to).getTime(); })));
  if (untilEl) untilEl.textContent = opts.compact
    ? "to " + hm(last) + " " + fmt(new Date(last.getTime() - 1), { weekday: "short" }) + " · " + hm(now)
    : "Prices to " + hm(last) + " " + when(new Date(last.getTime() - 1)) + " · " + drawn;

  var cur = slots[0];
  var box = {
    now: '<div class="stat now"><div class="k">Now ' + hm(cur.from) + '–' + hm(cur.to) + '</div>' +
         '<div class="v">' + cur.p.toFixed(1) + 'p</div>' +
         '<div class="s">' + (HAS_FLEX ? (cur.p <= FLEX ? "below" : "above") + ' Flexible ' + FLEX.toFixed(1) + 'p' : 'p/kWh inc VAT') + '</div></div>',
    best: '<div class="stat"><div class="k">Best 2 hours</div><div class="v">' + span(best) + '</div>' +
          '<div class="s">' + when(slots[best.i].from) + ' · avg ' + best.avg.toFixed(1) + 'p</div></div>',
    avoid: '<div class="stat"><div class="k">Avoid</div><div class="v">' + span(worst) + '</div>' +
           '<div class="s">' + when(slots[worst.i].from) + ' · avg ' + worst.avg.toFixed(1) + 'p</div></div>'
  };
  // Scale from the OG design width to whatever this device/layout gives us.
  var W = Math.floor(root.clientWidth || opts.W);
  var sc = Math.max(0.8, Math.min(2.2, W / opts.W));
  root.className = "agile" + (opts.compact ? " compact" : "");
  root.style.setProperty("--s", sc.toFixed(3));
  root.innerHTML = '<div class="stats">' + opts.stats.map(function (s) { return box[s]; }).join("") + '</div>';
  var area = root.closest(".layout") || root.parentElement;
  var legendH = opts.legend ? Math.ceil(26 * sc) : 0;
  var avail = area.clientHeight - root.querySelector(".stats").offsetHeight - legendH - Math.ceil(6 * sc);
  var H = avail > opts.H * 0.6 * sc ? Math.floor(avail) : Math.round(opts.H * sc);
  var px = function (v) { return Math.round(v * sc); };
  var fs = px(opts.compact ? 13 : 15);

  // ---- chart
  var L = px(opts.compact ? 26 : 34), R = px(6), T = px(opts.compact ? 18 : 26), XB = px(opts.compact ? 32 : 40);
  var ph = H - T - XB, pw = W - L - R, bw = pw / WINDOW;
  var ps = priced.map(function (s) { return s.p; });
  var lo = Math.min(0, Math.min.apply(null, ps)), hi = Math.max(HAS_FLEX ? FLEX : 0, Math.max.apply(null, ps));
  var step = hi - lo > 45 ? 20 : 10;
  if (opts.compact && hi - lo > 30) step = 20;
  lo = Math.floor(lo / step) * step; hi = Math.ceil(hi / step) * step;
  var y = function (v) { return T + ph - (v - lo) / (hi - lo) * ph; };
  // Legend keys are tiny SVGs using the chart's own pattern, so they match the bars exactly on 1-bit.
  var swatch = function (inner) {
    return '<svg width="' + px(20) + '" height="' + px(16) + '" viewBox="0 0 20 16">' + inner + '</svg>';
  };
  var g = [];
  g.push('<defs><pattern id="' + rootId + '-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">' +
         '<rect width="6" height="6" fill="#fff"/><rect width="3" height="6" fill="#000"/></pattern></defs>');
  for (var tk = lo; tk <= hi; tk += step) {
    g.push('<line x1="' + L + '" x2="' + (W - R) + '" y1="' + y(tk) + '" y2="' + y(tk) + '" stroke="#000" stroke-width="' +
           (tk === 0 ? 2 : 1) + '"' + (tk === 0 ? '' : ' stroke-dasharray="1 4"') + '/>');
    g.push('<text x="' + (L - 4) + '" y="' + (y(tk) + 5) + '" text-anchor="end" font-size="' + fs + '">' + tk + '</text>');
  }
  var gap = bw > 6 ? 2 : 1;
  slots.forEach(function (s, k) {
    var x = L + k * bw;
    if (s.p !== null) {
      var inWorst = worst && k >= worst.i && k < worst.i + 4;
      var fill = s.p <= cheapCut ? "#000" : inWorst ? "url(#" + rootId + "-hatch)" : "#fff";
      g.push('<rect x="' + (x + gap / 2) + '" y="' + y(Math.max(s.p, 0)) + '" width="' + Math.max(bw - gap, 1) + '" height="' +
             Math.max(Math.abs(y(s.p) - y(0)), 1) + '" fill="' + fill + '" stroke="#000" stroke-width="' + (bw > 6 ? 1.5 : 1) + '"/>');
    }
    if (k > 1 && s.from.getUTCMinutes() === 0 && +hm(s.from).slice(0, 2) % opts.tick === 0) {
      g.push('<line x1="' + x + '" x2="' + x + '" y1="' + y(lo) + '" y2="' + (y(lo) + 5) + '" stroke="#000" stroke-width="1.5"/>');
      g.push('<text x="' + x + '" y="' + (y(lo) + fs + 5) + '" text-anchor="middle" font-size="' + fs + '">' + hm(s.from) + '</text>');
    }
    if (k > 0 && hm(s.from) === "00:00") {
      g.push('<line x1="' + x + '" x2="' + x + '" y1="' + T + '" y2="' + y(lo) + '" stroke="#000" stroke-width="1.5" stroke-dasharray="4 3"/>');
      g.push('<text x="' + (x + 4) + '" y="' + (T + 12) + '" font-size="' + (fs - 1) + '">' + fmt(s.from, { weekday: "short" }) + '</text>');
    }
  });
  var nx = L + bw / 2, ay = y(lo) + px(opts.compact ? 27 : 33);
  g.push('<path d="M' + (nx - px(6)) + ' ' + ay + ' L' + nx + ' ' + (ay - px(10)) + ' L' + (nx + px(6)) + ' ' + ay + ' Z" fill="#000"/>');
  g.push('<text x="' + (nx + px(9)) + '" y="' + (ay + px(3)) + '" font-size="' + fs + '" font-weight="700">now</text>');
  var bx0 = L + best.i * bw + 1, bx1 = L + (best.i + 4) * bw - 1;
  var by = y(Math.max(slots[best.i].p, slots[best.i + 1].p, slots[best.i + 2].p, slots[best.i + 3].p, 0)) - px(7);
  g.push('<path d="M' + bx0 + ' ' + (by + px(5)) + ' V' + by + ' H' + bx1 + ' V' + (by + px(5)) + '" fill="none" stroke="#000" stroke-width="2"/>');
  g.push('<text x="' + ((bx0 + bx1) / 2) + '" y="' + (by - px(4)) + '" text-anchor="middle" font-size="' + fs + '" font-weight="700">best 2h</text>');
  if (nPriced < WINDOW) {
    var ux = L + nPriced * bw;
    g.push('<rect x="' + (ux + 2) + '" y="' + (T + px(14)) + '" width="' + (W - R - ux - 4) + '" height="' + (y(lo) - T - px(18)) +
           '" fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="5 4" rx="6"/>');
    g.push('<text x="' + ((ux + W - R) / 2) + '" y="' + (T + px(34)) + '" text-anchor="middle" font-size="' + fs + '">' +
           (W - R - ux > px(150) ? "next prices ~4pm" : "~4pm") + '</text>');
  }
  if (HAS_FLEX)
    g.push('<line x1="' + L + '" x2="' + (L + nPriced * bw) + '" y1="' + y(FLEX) + '" y2="' + y(FLEX) + '" stroke="#000" stroke-width="2" stroke-dasharray="8 5"/>');
  g.push('<text x="' + (L + 2) + '" y="' + (T - px(8)) + '" font-size="' + fs + '">p/kWh</text>');

  root.insertAdjacentHTML("beforeend",
    '<svg viewBox="0 0 ' + W + ' ' + H + '" width="' + W + '" height="' + H + '">' + g.join("") + '</svg>' +
    (opts.legend ? '<div class="legend">' +
      '<span>' + swatch('<rect x="1" y="1" width="18" height="14" fill="#000" stroke="#000" stroke-width="2"/>') + 'cheapest third</span>' +
      '<span>' + swatch('<rect x="1" y="1" width="18" height="14" fill="url(#' + rootId + '-hatch)" stroke="#000" stroke-width="2"/>') + 'avoid 2h</span>' +
      (HAS_FLEX ? '<span>' + swatch('<line x1="0" y1="8" x2="20" y2="8" stroke="#000" stroke-width="2" stroke-dasharray="5 3"/>') +
                  'Flexible ' + FLEX.toFixed(1) + 'p</span>' : '') +
    '</div>' : ''));
}
</script>
